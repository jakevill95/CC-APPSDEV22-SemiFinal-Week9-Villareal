
@page "/students"
@using StudentPortalUI.Components

<h1>Student Management</h1>

@if (isLoading)
{
    <p><em>Loading Students...</em></p>
}
else
{
    <div class="row">
        @foreach (StudentModel student in studentList)
        {
            <div class="col-md-4 mb-3">
                <StudentCard
                    Id="@student.Id"
                    Firstname="@student.Firstname"
                    Lastname="@student.Lastname"
                    Course="@student.Course"
                    YearLevel="@student.YearLevel"
                    OnDetailClick="HandleDetailClick" />
            </div>
        }
    </div>
}

<hr />

<h3>Add New Student</h3>

<div class="row">
    <div class="col-md-3">
        <input @bind="newFirstName"
               class="form-control mb-2"
               placeholder="First Name" />
    </div>

    <div class="col-md-3">
        <input @bind="newLastName"
               class="form-control mb-2"
               placeholder="Last Name" />
    </div>

    <div class="col-md-3">
        <input @bind="newCourse"
               class="form-control mb-2"
               placeholder="Course" />
    </div>

    <div class="col-md-2">
        <input @bind="newYearLevel"
               type="number"
               min="1"
               class="form-control mb-2"
               placeholder="Year Level" />
    </div>

    <div class="col-md-1">
        <button @onclick="AddStudent"
                class="btn btn-success">
            Add
        </button>
    </div>
</div>

@code {
    private bool isLoading = true;

    private List<StudentModel> studentList = new List<StudentModel>();

    private string newFirstName = "";
    private string newLastName = "";
    private string newCourse = "";
    private int newYearLevel = 1;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(1000);

        studentList = new List<StudentModel>
        {
            new StudentModel
            {
                Id = 1,
                Firstname = "Juan",
                Lastname = "Dela Cruz",
                Course = "BSCS",
                YearLevel = 3
            },

            new StudentModel
            {
                Id = 2,
                Firstname = "Maria",
                Lastname = "Clara",
                Course = "BSIT",
                YearLevel = 2
            }
        };

        isLoading = false;
    }

    private void AddStudent()
    {
        if (!string.IsNullOrWhiteSpace(newFirstName) &&
            !string.IsNullOrWhiteSpace(newLastName))
        {
            studentList.Add(new StudentModel
            {
                Id = studentList.Count + 1,
                Firstname = newFirstName,
                Lastname = newLastName,
                Course = newCourse,
                YearLevel = newYearLevel
            });

            newFirstName = "";
            newLastName = "";
            newCourse = "";
            newYearLevel = 1;
        }
    }

    private void HandleDetailClick(int id)
    {
        Console.WriteLine($"Viewing details for student ID: {id}");
    }

    public class StudentModel
    {
        public int Id { get; set; }

        public string Firstname { get; set; } = string.Empty;

        public string Lastname { get; set; } = string.Empty;

        public string Course { get; set; } = string.Empty;

        public int YearLevel { get; set; }
    }
}
